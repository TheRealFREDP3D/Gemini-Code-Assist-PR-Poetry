# Gemini Poetry Scanner - example environment configuration
# Copy this file to `.env` and fill in your values.

# REQUIRED for any real scan. Without a token GitHub caps you at 60 req/hour.
# Create one at: https://github.com/settings/tokens (classic PAT with public_repo
# scope, or a fine-grained token with read-only access to public repos).
GITHUB_TOKEN=ghp_your_token_here

# ISO date. PRs created on or before this date will be scanned.
# Default: 2026-07-17 (the day the consumer Gemini Code Assist bot was shut
# down on GitHub - https://developers.google.com/gemini-code-assist/docs/deprecations/consumer-code-review)
# CUTOFF_DATE=2026-07-17

# Optional output / log directories (defaults: ./output and ./logs)
# OUTPUT_DIR=./output
# LOG_DIR=./logs

# ---------------------------------------------------------------------
# Optional LLM adjudication (only used with `scan_poems.py --llm-adjudicate`)
# Requires `pip install litellm` and the provider's API key in the env
# (GEMINI_API_KEY, OPENAI_API_KEY, ...). Heuristic detection runs first and
# remains the default when this is disabled.
# ---------------------------------------------------------------------
# LLM_MODEL=gemini/gemini-2.5-flash
# Comma-separated fallbacks tried if the primary model fails:
# LLM_FALLBACK_MODELS=openai/gpt-4o-mini,ollama/llama3.1
# Heuristic candidates at/above this confidence skip the LLM (default 0.5):
# ADJUDICATE_THRESHOLD=0.5
# Cache directory for adjudication responses (default ./cache/llm):
# LLM_CACHE_DIR=./cache/llm
# Local Ollama host (only used for ollama/* models):
# OLLAMA_HOST=http://localhost:11434

# Search Tools
 # SERPER_API_KEY=